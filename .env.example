# Copy to .env and fill in. Never commit .env.
# Free key from https://api-manager.opentransportdata.swiss (subscribe to GTFS-RT).
# Without it the app shows the scheduled timetable only.
OTD_API_KEY=

# Optional: port and interface (default 8080 on all interfaces).
# Behind a reverse proxy (Caddy/nginx) bind to localhost only:
# PORT=8080
# HOST=127.0.0.1

# Production behind a reverse proxy: redirect http:// to https:// and send HSTS.
# TRUST_PROXY makes the server read X-Forwarded-Proto from the proxy.
# FORCE_HTTPS=1
# TRUST_PROXY=1

# Maintenance: take the map offline for the public. Visitors get a "back soon" page (HTTP 503);
# the imprint, privacy policy and /stats stay reachable. Remove it or set it to 0 to bring the map back.
# MAINTENANCE=1
